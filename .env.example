# Local-only by default. Never use VITE_ prefixes for secrets.
PORT=4317
HOST=127.0.0.1
VISION_PROVIDER=manual
# To enable real label/OCR suggestions, set provider to google or azure.
# GOOGLE_VISION_API_KEY=
# AZURE_VISION_KEY=
# AZURE_VISION_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
# Optional if putting the server behind a local HTTPS reverse proxy:
# APP_ORIGIN=https://thrifty.example.com

# Sign-in is separate from the Vision API key. Cloud scans stay locked until a
# sign-in method and private storage are configured.
# GOOGLE_AUTH_CLIENT_ID=your-web-client.apps.googleusercontent.com
# For Hostinger Email (use your provider's settings if different):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=your-existing-mailbox
# SMTP_PASSWORD=
# SMTP_FROM=your-existing-mailbox
# Optional; default production storage is private and survives deployments:
# AUTH_DB_PATH=/absolute/private/path/auth.sqlite
